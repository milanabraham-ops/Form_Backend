PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=Cluster0

# Public URL this backend is reachable at (used to build links to uploaded audio files in the sheet)
PUBLIC_BASE_URL=http://localhost:5000

# Google Sheets sync — requires a GCP service account with Sheets API access,
# shared as Editor on the target spreadsheet. Left blank, sync is skipped silently.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Google Drive backup copy of uploaded audio files — reuses the same service account
# as Sheets (needs Drive API enabled + shared as Editor on the target folder).
# Left blank, uploads still work, just skip the Drive copy.
GOOGLE_DRIVE_FOLDER_ID=

# Comma-separated list of allowed origins (e.g. your Vercel frontend URL).
# Left blank, all origins are allowed.
CORS_ORIGIN=

# Auth — random long string used to sign login tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google Sign-In — OAuth 2.0 Client ID (Web application) from GCP Console > APIs & Services
# > Credentials. NOT the service account above — this is a separate, public client ID.
# Must match VITE_GOOGLE_CLIENT_ID on the frontend.
GOOGLE_OAUTH_CLIENT_ID=

# Google Chat webhook notifications are configured live by an admin from the app's
# Manage Access > Notification Settings screen (stored in Mongo), not here — nothing to set
# in this file. Stays silently disabled until an admin fills the webhook URLs in there.
